# Copy to .env and fill in. Never commit .env.
#
# Base URLs below point at the "ollama" service name, which is correct when
# running via `podman compose` (the app container reaches Ollama through the
# compose network, not localhost -- localhost inside a container means that
# container itself). If running the app directly on your host instead of in
# a container, change these to http://localhost:11434.

# Generator: answers questions. Defaults to local Ollama.
GENERATOR__PROVIDER=ollama
GENERATOR__MODEL=llama3.1:8b
GENERATOR__BASE_URL=http://ollama:11434

# Judge: scores answers in `research-assistant evaluate`. Needs a real API
# key if provider is anthropic or openai; ollama needs none.
JUDGE__PROVIDER=anthropic
JUDGE__MODEL=claude-sonnet-5-5
JUDGE__API_KEY=

# Embeddings backend: ollama | huggingface
EMBEDDINGS_BACKEND=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://ollama:11434
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

INDEX_DIR=data/index
DOCS_DIR=data/documents

# BM25/answer cache. Points at the "valkey" service name, same reasoning as
# the Ollama URLs above -- http://localhost:6379 if running the app directly
# on your host instead of in a container.
CACHE_URL=redis://valkey:6379/0
