# Copy to .env and fill in. Never commit .env.
#
# Base URLs below point at the "ollama" service name, which is correct when
# running via `podman compose` (the app container reaches Ollama through the
# compose network, not localhost -- localhost inside a container means that
# container itself). If running the app directly on your host instead of in
# a container, change these to http://localhost:11434.

# Routing. Trims how many trailing conversation turns are sent into the
# intent-classification/query-rewrite LLM call. query_rewrite_enabled only
# affects that LLM call -- the free rules check for greetings/thanks/
# goodbyes always runs regardless of this setting.
HISTORY_MAX_TURNS=6

# Generator: answers questions. Defaults to local Ollama.
GENERATOR__PROVIDER=ollama
GENERATOR__MODEL=llama3.1:8b
GENERATOR__BASE_URL=http://ollama:11434

# To test against a hosted OpenAI-compatible endpoint instead, switch to:
# GENERATOR__PROVIDER=openai
# GENERATOR__MODEL=gpt-4o-mini
# GENERATOR__BASE_URL=https://your-gateway/v1
# GENERATOR__API_KEY comes from the host's own env var via
# docker-compose.openai-env.yml -- don't set it here too.

# Judge: scores answers in `ask-the-docs evaluate`. Needs a real API
# key if provider is anthropic or openai; ollama needs none.
JUDGE__PROVIDER=anthropic
JUDGE__MODEL=claude-sonnet-5-5
JUDGE__API_KEY=

# Embeddings backend: ollama | huggingface
EMBEDDINGS_BACKEND=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://ollama:11434

# Context window the Ollama container uses (default 8192). Compose reads this
# from your shell or a project-level .env file, NOT from .env.local, because
# .env.local is not passed to the ollama container. Raise it if long prompts
# get truncated; larger values use more memory per loaded model.
# OLLAMA_CONTEXT_LENGTH=8192

# Address the API listens on. Keep 127.0.0.1 unless you add your own auth and
# network controls: the API has no authentication. Compose overrides this inside
# the container and publishes ports on the host's loopback only.
# API_HOST=127.0.0.1
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

INDEX_DIR=data/index
DOCS_DIR=data/documents

# BM25/answer cache. Points at the "valkey" service name, same reasoning as
# the Ollama URLs above. Unlike Ollama, Valkey's port isn't published to the
# host (docker-compose.yml), so running the app directly on your host needs
# its own local Valkey/Redis, reachable as redis://localhost:6379/0.
CACHE_URL=redis://valkey:6379/0

# Graph RAG. Off by default, and the neo4j service only starts with
# `podman compose --profile graph up -d neo4j`. To use it, set GRAPH_ENABLED=true
# and choose your own password below (the app refuses to start without one).
GRAPH_ENABLED=false

# Neo4j Bolt URI. The app container reaches Neo4j through the compose network
# as neo4j:7687; running the app on the host uses the published port instead.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Neo4j server login, read by the neo4j container. Format is user/password and
# must match NEO4J_USER / NEO4J_PASSWORD above, e.g. neo4j/<your password>.
NEO4J_AUTH=

# Graph tunables.
ENTITY_RESOLUTION_SIMILARITY_THRESHOLD=0.85
GRAPH_TRAVERSAL_HOP_DEPTH=2
GLOBAL_SEARCH_TOP_COMMUNITIES=3
